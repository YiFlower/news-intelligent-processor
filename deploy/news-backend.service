[Unit]
Description=News Platform Backend API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/news-platform/backend
ExecStart=/usr/local/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/news-platform/.env

[Install]
WantedBy=multi-user.target
